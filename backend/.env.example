# Copy to .env. Never commit .env or Firebase service-account JSON.
ENVIRONMENT=development

# Groq API credentials (create a key at https://console.groq.com/keys)
GROQ_API_KEY=your_new_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Exact frontend origins. Add any Vercel preview domain you intend to use.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,https://bitsecure-ten.vercel.app

# Path to your Firebase Admin service-account JSON file.
# Windows example: C:/Users/YourUsername/Downloads/firebase-admin.json
# Linux example: /home/yourusername/Downloads/firebase-admin.json
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Alternative: set the minified Firebase Admin service-account JSON in this
# environment variable instead of using GOOGLE_APPLICATION_CREDENTIALS.
# Do not set both options.
# FIREBASE_SERVICE_ACCOUNT_JSON=
