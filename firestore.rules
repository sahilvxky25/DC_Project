rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep existing per-account data (progress, league profile and reward
    // idempotency events) private to its owning authenticated user.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Weekly league batch metadata and leaderboard entries are visible only
    // to a learner whose own profile points to this exact week and batch.
    // Member writes are restricted to the caller's own UID document.
    match /leagueWeeks/{weekId}/batches/{batchId} {
      function isMemberOfBatch() {
        return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/league/profile).data.weekId == weekId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/league/profile).data.batchId == batchId;
      }
      allow read: if isMemberOfBatch();
      allow create, update: if request.auth != null;
      allow delete: if false;

      match /members/{memberId} {
        function isMemberOfBatch() {
          return request.auth != null
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/league/profile).data.weekId == weekId
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/league/profile).data.batchId == batchId;
        }
        allow read: if isMemberOfBatch();
        allow create, update: if isMemberOfBatch() && request.auth.uid == memberId;
        allow delete: if false;
      }
    }

    // Payment records and webhook idempotency markers are server-only.
    match /contributions/{contributionId} {
      allow read, write: if false;
    }
    match /paymentWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // Deny all other documents unless a dedicated rule is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
