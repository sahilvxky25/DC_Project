rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userProfile(userId) {
      return /databases/$(database)/documents/users/$(userId)/league/profile;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /leagueWeeks/{weekId}/batches/{batchId} {
      function profileAfterJoin() {
        return getAfter(userProfile(request.auth.uid)).data.weekId == weekId
          && getAfter(userProfile(request.auth.uid)).data.batchId == batchId;
      }
      function ownMemberAfterJoin() {
        return existsAfter(/databases/$(database)/documents/leagueWeeks/$(weekId)/batches/$(batchId)/members/$(request.auth.uid));
      }

      // Batch metadata contains no learner-specific data. Authenticated users
      // can discover open batches; leaderboard documents remain membership-gated.
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.memberCount == 1
        && request.resource.data.memberCount <= 20
        && profileAfterJoin()
        && ownMemberAfterJoin();
      allow update: if request.auth != null
        && request.resource.data.tier == resource.data.tier
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && request.resource.data.memberCount <= 20
        && profileAfterJoin()
        && ownMemberAfterJoin();
      allow delete: if false;

      match /members/{memberId} {
        function isCurrentBatchMember() {
          return request.auth != null
            && get(userProfile(request.auth.uid)).data.weekId == weekId
            && get(userProfile(request.auth.uid)).data.batchId == batchId;
        }
        function joinsThisBatch() {
          return request.auth != null
            && getAfter(userProfile(request.auth.uid)).data.weekId == weekId
            && getAfter(userProfile(request.auth.uid)).data.batchId == batchId;
        }
        allow read: if request.auth != null && (memberId == request.auth.uid || isCurrentBatchMember());
        allow create, update: if request.auth != null
          && request.auth.uid == memberId
          && joinsThisBatch();
        allow delete: if false;
      }
    }

    // Only the trusted Cloudflare Worker service account can access payments.
    match /contributions/{contributionId} {
      allow read, write: if false;
    }
    match /paymentWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
