# Reference only. Cloudflare Worker local development uses cloudflare-dns-worker/.dev.vars.
# Never place RAZORPAY_KEY_SECRET in frontend environment variables.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret
ALLOWED_ORIGIN=https://your-frontend-domain.example
