[Unit]
Description=BitSecure receiver
After=network.target

[Service]
DynamicUser=yes
StateDirectory=bitsecure-receiver
EnvironmentFile=/etc/bitsecure/receiver.env
ExecStart=/usr/bin/python3 /opt/bitsecure-receiver/receiver.py --host 0.0.0.0 --port 9009 --name ${NODE_NAME} --log /var/lib/bitsecure-receiver/received.log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
