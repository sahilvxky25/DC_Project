[Unit]
Description=BitSecure API
After=network.target postgresql.service

[Service]
User=bitsecure
Group=bitsecure
WorkingDirectory=/opt/bitsecure/backend
EnvironmentFile=/etc/bitsecure/api.env
# --proxy-headers: use the visitor's real address (from Nginx) for the login rate limit
ExecStart=/opt/bitsecure/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
